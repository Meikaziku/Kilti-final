{# templates/search/index.html.twig #}
{% extends 'base.html.twig' %}

{% block nav_active %}explorer
{% endblock %}
{% block title %}Recherche "{{ query }}" — Kilti
{% endblock %}

{% block stylesheets %}
	<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
	<style>
		body {
			background: #0e0e0e;
		}

		@keyframes fadeUp {
			from {
				opacity: 0;
				transform: translateY(14px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}
		.fade-up {
			animation: fadeUp 0.4s ease both;
		}
		.fade-up-1 {
			animation-delay: 0.05s;
		}
		.fade-up-2 {
			animation-delay: 0.1s;
		}

		.card-glow:hover {
			box-shadow: 0 0 0 1px rgba(0, 229, 176, 0.25), 0 8px 32px rgba(0, 0, 0, 0.5);
		}
	</style>
{% endblock %}

{# Macro durée en minutes → "1h 20min" #}
{% macro duration(minutes) %}
	{%- if minutes is not null -%}
		{%- if minutes >= 60 -%}
			{{- (minutes / 60)|round(0, 'floor') }}h
			{%- if minutes % 60 > 0 %}
				{{ minutes % 60 }}min
			{% endif -%}
		{%- else -%}
			{{- minutes }}min
		{%- endif -%}
		{%- else -%}—
	{%- endif -%}
{% endmacro %}

{# Macro couleur pill catégorie #}
{% macro catClass(name) -%}
	{%- set n = name|lower -%}
	{%- if 'science' in n %}bg-sky-400/15 text-sky-400
		{%- elseif 'histoire' in n or 'prehist' in n %}bg-orange-400/15 text-orange-400
		{%- elseif 'animal' in n or 'nature' in n %}bg-emerald-400/15 text-emerald-400
		{%- elseif 'art' in n %}bg-pink-400/15 text-pink-400
		{%- elseif 'fi' in n %}bg-violet-400/15 text-violet-400
		{%- else %}bg-[#00e5b0]/15 text-[#00e5b0]
	{%- endif -%}
{%- endmacro %}

{% import _self as macros %}

{% block body %}
	<div
		class="min-h-screen bg-[#0e0e0e] text-white pb-28" style="font-family:'DM Sans',sans-serif;">

		{# ══ Header recherche ══ #}
		<div
			class="px-4 pt-5 pb-4 fade-up fade-up-1">

			{# Barre de recherche #}
			<form method="GET" action="{{ path('app_search') }}" class="flex items-center gap-2 mb-5">
				<div class="relative flex-1">
					<svg class="absolute left-3 top-1/2 -translate-y-1/2 text-[#555]" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
						<circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
					</svg>
					<input type="text" name="q" value="{{ query }}" placeholder="Rechercher sur Kilti…" autofocus class="w-full bg-[#1a1a1a] border border-[#2a2a2a] rounded-full
					                              pl-9 pr-4 py-2.5 text-sm text-white placeholder-[#555]
					                              outline-none focus:border-[#00e5b0] transition-colors">
				</div>
				<button type="submit" class="w-10 h-10 bg-[#00e5b0] text-black rounded-full flex items-center justify-center flex-shrink-0
						                           hover:bg-[#00c49a] transition-colors">
					<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewbox="0 0 24 24">
						<circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
					</svg>
				</button>
			</form>

			{# Résumé des résultats #}
			{% if query %}
				<div class="flex items-center gap-2">
					<span style="font-family:'Syne',sans-serif;" class="font-bold text-[18px]">
						"{{ query }}"
					</span>
					<span class="text-[#444] text-[13px]">
						—
						{{ results|length }}
						résultat{{ results|length > 1 ? 's' : '' }}
					</span>
				</div>
			{% endif %}
		</div>

		{# ══ Résultats ══ #}
		<div class="px-4 fade-up fade-up-2">

			{% if results is empty %}

				{# État vide #}
				<div class="flex flex-col items-center justify-center py-24 text-center">
					<div class="w-16 h-16 bg-[#1a1a1a] rounded-full flex items-center justify-center mb-4">
						<svg width="28" height="28" fill="none" stroke="#333" stroke-width="1.5" viewbox="0 0 24 24">
							<circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
						</svg>
					</div>
					<p style="font-family:'Syne',sans-serif;" class="font-bold text-[17px] text-[#333] mb-1">
						Aucun résultat
					</p>
					<p class="text-[#444] text-[13px] max-w-[220px] leading-relaxed">
						Aucun reportage trouvé pour "{{ query }}". Essaie un autre mot-clé.
					</p>
				</div>

			{% else %}

				<div class="flex flex-col gap-3">
					{% for reportage in results %}

						{# On n'affiche que les reportages validés #}
						{% if reportage.isValidated %}
							<article
								class="card-glow group bg-[#141414] rounded-2xl overflow-hidden
									                                border border-[#1e1e1e] hover:border-[#2a2a2a]
									                                transition-all duration-200">

								{# Thumbnail #}
								{% if reportage.image %}
									<div class="relative overflow-hidden" style="height:150px;">
										<img src="{{ reportage.imagePath }}" alt="{{ reportage.title }}" class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500">
										<div class="absolute inset-0 bg-gradient-to-t from-[#141414] via-[#14141430] to-transparent"></div>

										{# Badge catégorie #}
										<span class="absolute top-3 left-3 text-[10px] font-semibold px-2.5 py-1
												                                     rounded-full uppercase tracking-wide {{ macros.catClass(reportage.category.name) }}">
											{{ reportage.category.name }}
										</span>

										{# Badge durée #}
										{% if reportage.duration %}
											<span class="absolute top-3 right-3 flex items-center gap-1 bg-black/50 backdrop-blur-sm
													                                     border border-white/10 rounded-full px-2.5 py-1 text-[10px] text-white/80">
												<svg width="9" height="9" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
													<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
												</svg>
												{{ macros.duration(reportage.duration) }}
											</span>
										{% endif %}
									</div>
								{% endif %}

								{# Contenu #}
								<div class="p-4">
									<div class="flex items-start justify-between mb-2">
										<h2 style="font-family:'Syne',sans-serif;" class="font-bold text-[15px] leading-tight">
											{{ reportage.title }}
										</h2>
										{% if reportage.createdAt %}
											<span class="text-[#444] text-[10px] ml-2 flex-shrink-0 mt-0.5">
												{{ reportage.createdAt|date('d/m/Y') }}
											</span>
										{% endif %}
									</div>

									<p class="text-[#666] text-[12px] leading-relaxed mb-4">
										{% set desc = reportage.description|striptags %}
										{{ desc|length > 120 ? desc|slice(0, 120) ~ '…' : desc }}
									</p>

									{# Actions #}
									<div class="flex gap-2">
										<button class="watchlist-toggle flex items-center gap-1.5 border border-[#2a2a2a]
											                                           rounded-full px-3.5 py-2 text-[11px] font-medium text-[#888]
											                                           hover:border-[#00e5b0] hover:text-[#00e5b0] transition-all duration-200" data-added="0">
											<svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewbox="0 0 24 24">
												<path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
											</svg>
											Watchlist
										</button>
										<a href="{{ reportage.url }}" target="_blank" rel="noopener" class="flex-1 flex items-center justify-center gap-1.5 bg-[#00e5b0] text-black
												                                      rounded-full py-2 text-[12px] font-bold
												                                      hover:bg-[#00c49a] active:scale-95 transition-all duration-150">
											<svg width="10" height="10" fill="currentColor" viewbox="0 0 24 24">
												<polygon points="5 3 19 12 5 21 5 3"/>
											</svg>
											Voir le reportage
										</a>
									</div>
								</div>
							</article>
						{% endif %}

					{% endfor %}
				</div>

			{% endif %}
		</div>

	</div>

	<script>
		document.querySelectorAll('.watchlist-toggle').forEach(btn => {
btn.addEventListener('click', () => {
const added = btn.dataset.added === '1'
const svg = btn.querySelector('svg')
if (added) {
btn.dataset.added = '0'
btn.classList.remove('border-[#00e5b0]', 'text-[#00e5b0]', 'bg-[#00e5b0]/5')
svg.innerHTML = '<path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>'
btn.lastChild.textContent = ' Watchlist'
} else {
btn.dataset.added = '1'
btn.classList.add('border-[#00e5b0]', 'text-[#00e5b0]', 'bg-[#00e5b0]/5')
svg.innerHTML = '<polyline points="20 6 9 17 4 12"/>'
btn.lastChild.textContent = ' Ajouté ✓'
}
})
})
	</script>

{% endblock %}
