<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<title>
			{% block title %}Kilti{% endblock %}
		</title>

		<link rel="icon" href="data:image/svg+xml,
		    <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'>
		        <text y='1.2em' font-size='96'>⚫️</text>
		        <text y='1.3em' x='0.2em' font-size='76' fill='white'>sf</text>
		    </svg>"> {% block stylesheets %}{% endblock %}

		{# ✅ Importmap doit être dans head #}
		{{ importmap('app') }}

	</head>

	<script src="https://cdn.jsdelivr.net/npm/flowbite@2.3.0/dist/flowbite.min.js"></script>

	<body>

		{# ===============================
		   FLASH MESSAGE SYSTEM
		================================ #}
		{% for message in app.flashes('success') %}
			<div class="toast-notification fixed bottom-12 left-6 bg-[#0057FF]
			            text-white px-6 py-3 rounded-lg shadow-lg font-manrope
			            text-lg z-50 opacity-0 translate-y-6 transition-all duration-500">
				{{ message }}
			</div>
		{% endfor %}

		<script>
			document.addEventListener("DOMContentLoaded", function () {
				document.querySelectorAll(".toast-notification").forEach(toast => {
					setTimeout(() => { toast.classList.remove("opacity-0", "translate-y-6"); }, 100);
					setTimeout(() => {
						toast.classList.add("opacity-0", "translate-y-6");
						setTimeout(() => toast.remove(), 500);
					}, 5000);
				});
			});
		</script>

		{# ===============================
		   HEADER DESKTOP
		================================ #}
		{% block header %}
			<header class="hidden lg:flex w-full justify-between items-center px-6 py-4 bg-white">

				<div class="flex items-center gap-2 sm:gap-8">

					<a href="{{ path('app_home') }}" class="font-oleo text-[28px] font-bold sm:text-[32px] text-black hover:opacity-80">
						Kilti
					</a>

					{% if app.user %}
						<a href="{{ path('app_profile_publish') }}" class="font-manrope text-black text-[14px] hover:text-[#0057FF] transition">
							Profil
						</a>
					{% endif %}

					<a href="{{ path('app_explorer') }}" class="font-manrope text-black text-[14px] hover:text-[#0057FF] transition">
						Explorer
					</a>

					<form method="GET" action="{{ path('app_search') }}"
					      class="flex items-center gap-6 rounded-full bg-[#F5F5F5] px-3 py-1 border-2 border-[#E0E0E0]">

						<div class="flex gap-2 items-center w-full">
							<img class="w-[18px]" src="{{ asset('images/loupe.png') }}" alt="Loupe">
							<input type="text" name="q" value="{{ app.request.query.get('q') }}" placeholder="Recherche" class="bg-transparent outline-none text-sm">
						</div>

						{# Bouton recherche #}
						<button type="submit" title="Rechercher" class="cursor-pointer">
							<svg class="w-[18px] h-[18px] text-[#666]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="11" cy="11" r="8"/>
								<line x1="21" y1="21" x2="16.65" y2="16.65"/>
							</svg>
						</button>

						{# Bouton filtre (ouvre le drawer) #}
						<button type="button" onclick="kiltiDrawer.open()" title="Filtrer" class="cursor-pointer">
							<img class="w-[18px]" src="{{ asset('images/filtre.png') }}" alt="filtre">
						</button>

					</form>

				</div>

				{# ================= AUTH BUTTONS ================= #}
				<div class="flex items-center gap-2">

					{% if app.user %}
						{% if is_granted('ROLE_MODERATOR') %}
							<a href="/admin" class="rounded-lg bg-[#00e5b0] border border-[#00e5b0] px-4 py-2 mr-1">
								<span class="font-nunito text-black text-[14px] font-extrabold">Admin</span>
							</a>
						{% endif %}

						<a href="{{ path('app_watchlist') }}" class="font-manrope text-black text-[14px] hover:text-[#0057FF] transition mr-2">
							Watchlist
						</a>

						<a href="{{ path('app_logout') }}" class="rounded-lg bg-[#0057FF] border border-[#E0E0E0] px-4 py-2">
							<span class="font-nunito text-white text-[14px] font-extrabold">Logout</span>
						</a>

					{% else %}
						<a href="{{ path('app_login') }}" class="rounded-lg bg-[#0057FF] border border-[#E0E0E0] px-4 py-2">
							<span class="font-nunito text-white text-[14px] font-bold">Login</span>
						</a>
						<a href="{{ path('app_register') }}" class="rounded-lg bg-[#FFFFFF] border border-[#E0E0E0] px-4 py-2">
							<span class="font-nunito text-[#0057FF] text-[14px] font-bold">Register</span>
						</a>
					{% endif %}

				</div>

			</header>
		{% endblock %}

		{# ===============================
		   MOBILE NAVBAR
		================================ #}
		<div class="lg:hidden w-full z-50 flex justify-between items-center px-4 py-3 bg-[#1c1c1c] border-b border-[#2a2a2a]">

			<a href="{{ path('app_home') }}" class="font-oleo text-[24px] text-white font-bold">
				Kilti
			</a>

			<div class="flex items-center gap-2">

				{% if app.user %}
					<a href="{{ path('app_logout') }}" class="rounded-lg bg-[#0057FF] px-3 py-1.5">
						<span class="text-white text-[13px] font-bold">Logout</span>
					</a>
				{% else %}
					<a href="{{ path('app_login') }}" class="rounded-lg bg-[#0057FF] px-3 py-1.5">
						<span class="text-white text-[13px] font-extrabold">Login</span>
					</a>
					<a href="{{ path('app_register') }}" class="rounded-lg bg-[#FFFFFF] px-3 py-1.5">
						<span class="text-[#0057FF] text-[13px] font-bold">Register</span>
					</a>
				{% endif %}

			</div>

		</div>

		{# ===============================
		   PAGE CONTENT
		================================ #}
		{% block body %}{% endblock %}

		{# ===============================
		   FILTER DRAWER (toujours rendu, ouvert depuis desktop ou mobile)
		================================ #}
		{% include 'components/filter_drawer.html.twig' %}

		{# ===============================
		   MOBILE BOTTOM NAV (masquée sur les pages auth via {% block bottom_nav %}{% endblock %})
		================================ #}
		{% block bottom_nav %}
		<div class="lg:hidden">
			{% include 'components/bottom_nav.html.twig'
			   with { active: block('nav_active') ?? '' } %}
		</div>

		<div class="h-20 lg:hidden"></div>
		{% endblock %}

		{% block javascripts3 %}{% endblock %}

	</body>
</html>
