{% extends 'base.html.twig' %}

{% block title %}Ma Watchlist — Kilti{% endblock %}

{% block body %}
<body class="bg-[#1c1c1c] min-h-screen">

    <main class="px-6 md:px-12 lg:px-16 py-6 lg:py-8">

        {# ===========================================================
           PROFILE NAV
        =========================================================== #}
        <div class="flex gap-3 font-manrope text-[16px] text-white items-center mb-2">
            <a class="text-[#0057FF]" href="{{ path('app_watchlist') }}">Watchlist</a>
            <div class="h-5 w-px bg-white/40"></div>
            <a class="text-white hover:text-[#0057FF]" href="{{ path('app_profile_publish') }}">Publier</a>
        </div>
        <div class="w-full h-px bg-[#403C3C] mb-8"></div>

        {# ===========================================================
           HEADER avec titre + filtres
        =========================================================== #}
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-8">
            {# Bloc titre #}
            <div class="flex gap-4">
                <div class="w-1 bg-[#0057FF] flex-shrink-0"></div>
                <div class="flex flex-col gap-2">
                    <p class="font-manrope font-semibold text-[#0057FF] text-sm md:text-base uppercase tracking-wide">
                        Ma collection · reportages sauvegardes
                    </p>
                    <h1 class="font-nunito text-white font-bold text-3xl md:text-4xl lg:text-5xl leading-tight">
                        Ma <span class="text-[#0057FF] italic">Watch List</span>
                    </h1>
                    <p class="flex items-center gap-2 font-manrope text-white/80 text-sm">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                        </svg>
                        <span class="font-bold">{{ watchlistCount }}</span>
                        reportage{{ watchlistCount > 1 ? 's' : '' }} sauvegardé{{ watchlistCount > 1 ? 's' : '' }}
                    </p>
                </div>
            </div>

            {# Filtres par catégorie #}
            {% if availableCategories|length > 0 %}
                <div class="flex flex-wrap items-center gap-2">
                    <span class="text-gray-400 text-sm mr-1">Filtrer :</span>

                    <a href="{{ path('app_watchlist') }}"
                       class="px-4 py-1.5 rounded-full text-sm font-semibold transition
                              {{ currentCategory is null ? 'bg-[#3a3030] text-white' : 'bg-transparent text-white/70 border border-white/20 hover:bg-[#3a3030]' }}">
                        Tous
                    </a>

                    {% for cat in availableCategories %}
                        <a href="{{ path('app_watchlist', { category: cat.id }) }}"
                           class="px-4 py-1.5 rounded-full text-sm font-semibold transition
                                  {{ currentCategory == cat.id ~ '' ? 'bg-[#3a3030] text-white' : 'bg-transparent text-white/70 border border-white/20 hover:bg-[#3a3030]' }}">
                            {{ cat.name }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="w-full h-px bg-[#403C3C] mb-8"></div>

        {# ===========================================================
           GRILLE DES REPORTAGES
        =========================================================== #}
        {% if watchlist is empty %}
            <div class="text-center text-gray-400 py-20">
                <svg class="w-16 h-16 mx-auto mb-4 text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                </svg>
                <p class="text-lg mb-2">
                    {% if currentCategory %}
                        Aucun reportage dans cette catégorie.
                    {% else %}
                        Votre watchlist est vide.
                    {% endif %}
                </p>
                <a href="{{ path('app_explorer') }}" class="inline-block mt-4 text-[#00e5b0] underline">
                    Découvrir des reportages
                </a>
            </div>
        {% else %}
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4 md:gap-6">
                {% for item in watchlist %}
                    {% include 'components/content_card.html.twig' with { content: item.content } only %}
                {% endfor %}
            </div>
        {% endif %}
    </main>

</body>
{% endblock %}

{% block nav_active %}watchlist{% endblock %}
