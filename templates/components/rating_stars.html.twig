{# templates/components/rating_stars.html.twig

   Affiche une note sous forme de 5 étoiles (pleines / demi / vides).

   Paramètres :
     - rating (float|null) : note entre 0 et 5 (null = pas de note)
     - size   (string)     : 'xs' | 'sm' | 'md' | 'lg'  (par défaut 'sm')
     - color  (string)     : classe Tailwind de couleur (par défaut text-[#00e5b0])
     - showValue (bool)    : afficher la valeur numérique à droite (false par défaut)

   Usage :
     {% include 'components/rating_stars.html.twig' with { rating: content.rating } %}
#}

{% set size = size|default('sm') %}
{% set color = color|default('text-[#00e5b0]') %}
{% set showValue = showValue|default(false) %}

{% set sizeClasses = {
    'xs': 'w-3 h-3',
    'sm': 'w-4 h-4',
    'md': 'w-5 h-5',
    'lg': 'w-6 h-6'
} %}

{% if rating is not null and rating > 0 %}
    <div class="inline-flex items-center gap-1">
        {% set fullStars = rating|round(0, 'floor') %}
        {% set hasHalf = (rating - fullStars) >= 0.25 and (rating - fullStars) < 0.75 %}
        {% set finalStars = (rating - fullStars) >= 0.75 ? fullStars + 1 : fullStars %}

        {% for i in 1..5 %}
            {% if i <= finalStars %}
                {# Étoile pleine #}
                <svg class="{{ sizeClasses[size] }} {{ color }}" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
            {% elseif i == finalStars + 1 and hasHalf %}
                {# Étoile à moitié pleine #}
                <svg class="{{ sizeClasses[size] }} {{ color }}" viewBox="0 0 24 24">
                    <defs>
                        <linearGradient id="half-{{ random() }}">
                            <stop offset="50%" stop-color="currentColor"/>
                            <stop offset="50%" stop-color="transparent"/>
                        </linearGradient>
                    </defs>
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor" fill-opacity="0.4"/>
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77V2z" fill="currentColor"/>
                </svg>
            {% else %}
                {# Étoile vide #}
                <svg class="{{ sizeClasses[size] }} {{ color }} opacity-30" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
            {% endif %}
        {% endfor %}

        {% if showValue %}
            <span class="ml-1 text-sm font-semibold {{ color }}">{{ rating|number_format(1, '.', '') }}</span>
        {% endif %}
    </div>
{% endif %}
