# =================================================================
# CONFIGURATION LOCALE — copie ce fichier en .env.local et adapte
# =================================================================
#
# .env.local est ignoré par Git (cf. .gitignore) et surcharge les
# variables définies dans .env. C'est ici que tu mets tes identifiants
# de base de données pour TON poste.

# -----------------------------------------------------------------
# BASE DE DONNÉES
# -----------------------------------------------------------------
# Format MySQL : mysql://USER:PASSWORD@HOST:PORT/DB_NAME?...
#
# Exemples typiques :
#   Laragon (Windows)  : root, pas de mot de passe
#   XAMPP   (Windows)  : root, pas de mot de passe
#   MAMP    (Mac)      : root, mot de passe "root"
#   Linux apt          : selon ta config

DATABASE_URL="mysql://root:@127.0.0.1:3306/kilti?serverVersion=8.0.32&charset=utf8mb4"

# -----------------------------------------------------------------
# ENVIRONNEMENT
# -----------------------------------------------------------------
# Laisser sur "dev" pour le développement local.
APP_ENV=dev

# -----------------------------------------------------------------
# MAILER (envoi d'e-mails de vérification)
# -----------------------------------------------------------------
# Pour le développement, utilise un service comme Mailpit ou Mailtrap
# qui intercepte les e-mails sans les envoyer réellement.
#
# Mailpit (par défaut, port 1025) :
# MAILER_DSN=smtp://127.0.0.1:1025
#
# Désactiver complètement l'envoi :
MAILER_DSN=null://null
